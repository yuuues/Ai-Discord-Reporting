# ============================================================================
# Discord Personal Account Configuration (Phase 1: Read-Only Export)
# Caution: Discord disallows automated user accounts (self-bots) under its Terms
# of Service, and personal account tokens carry security and account-suspension
# risks. Never share or commit your token, and only use this tool for polite,
# read-only exports of servers you have permission to analyze.
# ============================================================================
DISCORD_USER_TOKEN=your_discord_user_token_here
# Target Discord Server (Guild) ID to export (right-click server icon -> Copy Server ID)
DISCORD_GUILD_ID=
# Polite delay in milliseconds between paginated Discord REST requests (default: 350ms)
DISCORD_REQUEST_DELAY_MS=350

# ============================================================================
# Summarizer / LLM Configuration (Phase 2: DeepSeek by default)
# Supports "deepseek", "openai" (OpenAI, Groq, Together, or local Ollama v1 API)
# or "fallback" (built-in deterministic keyword & Q&A analyzer, no API key required)
# ============================================================================
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Default is DeepSeek API. For OpenAI use: https://api.openai.com/v1 | For Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# Use deepseek-flash (auto-falls back to deepseek-chat if needed on official DeepSeek endpoint)
LLM_MODEL=deepseek-flash

# ============================================================================
# Server-Wide 3-Month Support Report Configuration
# ============================================================================
# Default lookback period in days for full-server support analysis (90 days = 3 months)
REPORT_LOOKBACK_DAYS=90
# Maximum messages to fetch per channel during full-server export (0 = unlimited within lookback days)
REPORT_MAX_MESSAGES_PER_CHANNEL=5000
# Number of messages per chunk when running Map-Reduce summarization with DeepSeek
REPORT_CHUNK_SIZE=150
# Optional comma-separated list of channel names or IDs to include exclusively (leave empty to analyze all channels)
# Example for testing just 1 chat and 1 forum: REPORT_INCLUDE_CHANNELS=chat,support
REPORT_INCLUDE_CHANNELS=
# Optional comma-separated list of channel names or IDs to exclude (e.g., "off-topic,memes,staff-logs")
REPORT_EXCLUDE_CHANNELS=
# Optional comma-separated keywords or channel names to classify as Q&A / Question channels
# (Defaults automatically detect: questions, preguntas, dudas, help, ayuda, support, soporte, faq, bugs, etc.)
REPORT_QA_CHANNELS=questions,preguntas,dudas,help,ayuda,support,soporte,faq,troubleshooting,bugs,install
# Directory where raw exported channel histories and final Markdown reports are saved
DATA_DIR=data
